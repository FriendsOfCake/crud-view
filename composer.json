{
    "name": "friendsofcake/crud-view",
    "description": "View layer for CRUD",
    "type": "cakephp-plugin",
    "keywords": [
        "cakephp",
        "crud",
        "create",
        "retrieve",
        "update",
        "delete",
        "bake",
        "cake",
        "scaffold",
        "scaffolding"
    ],
    "homepage": "https://github.com/FriendsOfCake/crud-view",
    "license": "MIT",
    "authors": [
        {
            "name": "Christian Winther",
            "role": "Author",
            "homepage": "http://cakephp.nu/"
        },
        {
            "name": "Jose Diaz-Gonzalez",
            "role": "Author",
            "homepage": "http://josediazgonzalez.com/"
        }
    ],
    "require": {
        "cakephp/cakephp": "^6.0",
        "friendsofcake/crud": "dev-cake6",
        "friendsofcake/bootstrap-ui": "dev-cake6"
    },
    "require-dev": {
        "friendsofcake/cakephp-test-utilities": "dev-cake6",
        "friendsofcake/search": "dev-cake6",
        "markstory/asset_compress": "^6.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "CrudView\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CrudView\\Test\\": "tests"
        }
    },
    "support": {
        "source": "https://github.com/FriendsOfCake/crud-view",
        "issues": "https://github.com/FriendsOfCake/crud-view/issues"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
